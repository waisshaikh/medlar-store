PORT=3000
NODE_ENV=development

# MongoDB: use either a full Atlas URI, or MONGO_URL + DB_NAME for a local MongoDB
MONGODB_URI=
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=medlar

# Any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Seller access + seeded accounts (created on first start)
SELLER_EMAILS=waisshaikh394@gmail.com
SEED_SELLER_PASSWORD=Medlar@Seller2026
SEED_BUYER_EMAIL=buyer@medlar.test
SEED_BUYER_PASSWORD=Buyer@12345

# Cloudinary (API key must have upload permission)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (optional) - redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:3000
